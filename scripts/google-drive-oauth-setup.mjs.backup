import nextEnv from "@next/env";

const { loadEnvConfig } = nextEnv;
import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
import { execFile } from "node:child_process";
import { readFile, writeFile } from "node:fs/promises";
import { createServer } from "node:http";
import { promisify } from "node:util";

loadEnvConfig(process.cwd());

const execFileAsync = promisify(execFile);
const clientId = process.env.GOOGLE_DRIVE_CLIENT_ID;
const clientSecret = process.env.GOOGLE_DRIVE_CLIENT_SECRET;
const rootFolderId = process.env.GOOGLE_DRIVE_ROOT_FOLDER_ID;
const redirectUri = process.env.GOOGLE_DRIVE_REDIRECT_URI || "http://localhost:53682/oauth2callback";
const expectedRedirect = new URL("http://localhost:53682/oauth2callback");
const configuredRedirect = new URL(redirectUri);
const envFile = `${process.cwd()}/.env.local`;
const authTimeoutMs = 4 * 60_000;

function stop(message) {
  console.error(message);
  process.exitCode = 1;
}

function safeEqual(left, right) {
  const a = Buffer.from(left);
  const b = Buffer.from(right);
  return a.length === b.length && timingSafeEqual(a, b);
}

async function persistRefreshToken(refreshToken) {
  let contents;
  try { contents = await readFile(envFile, "utf8"); }
  catch { contents = ""; }
  if (/^GOOGLE_DRIVE_REFRESH_TOKEN_NEXT\s*=/m.test(contents)) throw new Error("A rotated Drive credential is already configured; review it before replacing it.");
  const eol = contents.includes("\r\n") ? "\r\n" : "\n";
  const separator = contents.length && !contents.endsWith("\n") ? eol : "";
  const next = `${contents}${separator}# Fresh Google Drive token. Existing Google Sheets credential remains unchanged.${eol}GOOGLE_DRIVE_REFRESH_TOKEN_NEXT=${refreshToken}${eol}`;
  await writeFile(envFile, next, { encoding: "utf8", mode: 0o600 });
}

async function openBrowser(url) {
  if (process.platform !== "win32") return false;
  try {
    await execFileAsync("rundll32.exe", ["url.dll,FileProtocolHandler", url], { windowsHide: true, timeout: 5_000 });
    return true;
  } catch { return false; }
}

async function authorize() {
  if (!clientId || !clientSecret || !rootFolderId) throw new Error("Set the server-only Google Drive client and root folder environment variables first.");
  if (configuredRedirect.href !== expectedRedirect.href || configuredRedirect.protocol !== "http:") throw new Error("Use http://localhost:53682/oauth2callback as the local Google OAuth redirect URI.");

  const state = randomBytes(32).toString("base64url");
  const verifier = randomBytes(48).toString("base64url");
  const challenge = createHash("sha256").update(verifier).digest("base64url");
  const authorizeUrl = new URL("https://accounts.google.com/o/oauth2/v2/auth");
  authorizeUrl.search = new URLSearchParams({ console.log(
  "[Drive OAuth] Client ID used:",
  `${clientId.slice(0, 18)}...${clientId.slice(-16)}`
);
    client_id: clientId,
    redirect_uri: redirectUri,
    response_type: "code",
    access_type: "offline",
    prompt: "consent",
    include_granted_scopes: "true",
    scope: "https://www.googleapis.com/auth/drive",
    state,
    code_challenge: challenge,
    code_challenge_method: "S256",
  }).toString();

  const server = createServer();
  const callback = new Promise((resolve, reject) => {
    const timer = setTimeout(() => reject(new Error("Google authorization timed out.")), authTimeoutMs);
    server.once("error", () => { clearTimeout(timer); reject(new Error("Local OAuth callback could not start. Port 53682 may be in use.")); });
    server.on("request", (request, response) => {
      const received = new URL(request.url || "/", redirectUri);
      if (received.pathname !== "/oauth2callback") {
        response.writeHead(404).end();
        return;
      }
      const returnedState = received.searchParams.get("state") || "";
      if (!safeEqual(returnedState, state)) {
        response.writeHead(400, { "content-type": "text/plain; charset=utf-8" }).end("Google authorization state validation failed. You may close this tab.");
        clearTimeout(timer);
        reject(new Error("Google authorization state could not be verified."));
        return;
      }
      const providerError = received.searchParams.get("error");
      const code = received.searchParams.get("code");
      if (providerError || !code) {
        response.writeHead(400, { "content-type": "text/plain; charset=utf-8" }).end("Google Drive authorization was not completed. You may close this tab.");
        clearTimeout(timer);
        reject(new Error("Google authorization was denied or returned no code."));
        return;
      }
      response.writeHead(200, { "content-type": "text/html; charset=utf-8", "cache-control": "no-store", "referrer-policy": "no-referrer" }).end("<!doctype html><title>Drive authorization complete</title><p>Google Drive authorization is complete. Return to the terminal.</p>");
      clearTimeout(timer);
      resolve(code);
    });
    server.listen(53682, "127.0.0.1");
  });

  await new Promise((resolve, reject) => server.once("listening", resolve).once("error", reject));
  const opened = await openBrowser(authorizeUrl.href);
  if (!opened) console.log(`Open this Google authorization URL in your browser:\n${authorizeUrl.href}`);
  else console.log("Google authorization opened in your browser. Complete consent there, then return here.");

  let code;
  try { code = await callback; }
  finally { server.close(); }

  const tokenResponse = await fetch("https://oauth2.googleapis.com/token", {
    method: "POST",
    headers: { "content-type": "application/x-www-form-urlencoded" },
    body: new URLSearchParams({ client_id: clientId, client_secret: clientSecret, code, code_verifier: verifier, redirect_uri: redirectUri, grant_type: "authorization_code" }),
    signal: AbortSignal.timeout(15_000),
  });
  if (!tokenResponse.ok) throw new Error("Google could not exchange the authorization code. Check OAuth client configuration and redirect URI.");
  const token = await tokenResponse.json();
  if (!token.refresh_token) throw new Error("Google returned no refresh token. Re-run consent with offline access enabled.");
const rootResponse = await fetch(`https://www.googleapis.com/drive/v3/files/${encodeURIComponent(rootFolderId)}?fields=id,name,mimeType,trashed&supportsAllDrives=true`, { headers: { Authorization: `Bearer ${access}` }, signal: AbortSignal.timeout(15_000) });
  const access = token.access_token;
  
  if (!rootResponse.ok) throw new Error("The authorized Google account cannot access the configured Drive root folder. Check folder ownership and requested OAuth scope.");
  const root = await rootResponse.json();
  if (root.trashed || root.mimeType !== "application/vnd.google-apps.folder") throw new Error("The configured Drive root ID is not an available folder.");

  const boundary = `babe_setup_${randomBytes(12).toString("hex")}`;
  const testName = `.babe-drive-connection-check-${Date.now()}.pdf`;
  const pdf = Buffer.from("%PDF-1.4\n1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\n2 0 obj<</Type/Pages/Count 0/Kids[]>>endobj\ntrailer<</Root 1 0 R>>\n%%EOF\n");
  const metadata = { name: testName, mimeType: "application/pdf", parents: [rootFolderId], appProperties: { babeIntegrationCheck: "temporary" } };
  const body = Buffer.concat([Buffer.from(`--${boundary}\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n${JSON.stringify(metadata)}\r\n--${boundary}\r\nContent-Type: application/pdf\r\n\r\n`), pdf, Buffer.from(`\r\n--${boundary}--`)]);
  const uploadResponse = await fetch("https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id,name,mimeType,size,webViewLink,parents", { method: "POST", headers: { Authorization: `Bearer ${access}`, "content-type": `multipart/related; boundary=${boundary}` }, body, signal: AbortSignal.timeout(30_000) });
  if (!uploadResponse.ok) throw new Error("The temporary PDF upload test failed.");
  const uploaded = await uploadResponse.json();
  try {
    if (uploaded.mimeType !== "application/pdf" || uploaded.parents?.[0] !== rootFolderId) throw new Error("The temporary PDF upload returned unexpected metadata.");
    const metadataResponse = await fetch(`https://www.googleapis.com/drive/v3/files/${encodeURIComponent(uploaded.id)}?fields=id,name,mimeType,webViewLink,parents`, { headers: { Authorization: `Bearer ${access}` }, signal: AbortSignal.timeout(15_000) });
    if (!metadataResponse.ok) throw new Error("The uploaded PDF metadata could not be read back.");
  } finally {
    const deleteResponse = await fetch(`https://www.googleapis.com/drive/v3/files/${encodeURIComponent(uploaded.id)}`, { method: "DELETE", headers: { Authorization: `Bearer ${access}` }, signal: AbortSignal.timeout(15_000) }).catch(() => null);
    if (!deleteResponse || (!deleteResponse.ok && deleteResponse.status !== 404)) throw new Error("The temporary PDF was uploaded but cleanup was not confirmed. Remove the .babe-drive-connection-check file from the configured Drive folder.");
  }

  await persistRefreshToken(token.refresh_token);
}

authorize().then(() => {
  console.log("Google Drive authorization, root-folder access, temporary PDF upload, metadata readback, and cleanup succeeded. A new Drive-only refresh token was saved to ignored .env.local; existing credentials were left untouched. Restart Next.js and the worker to load it.");
}).catch(error => {
  stop(error instanceof Error ? error.message : "Google Drive authorization setup failed.");
});
